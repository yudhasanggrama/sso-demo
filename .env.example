# Salin berkas ini menjadi .env lalu sesuaikan bila perlu.
# Nilai default sudah cocok dengan MySQL/MariaDB lokal (mis. XAMPP) tanpa password.

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=db_sso_demo

REDIS_URL=redis://127.0.0.1:6379

PORTAL_PORT=3000

# WAJIB diisi sebelum dipakai sungguhan (data 2FA sekarang tersimpan permanen di MySQL):
# kunci ini dipakai mengenkripsi secret TOTP dan nomor SMS. Kalau kosong, kunci dibuat acak
# tiap kali server start — akibatnya SEMUA pendaftaran 2FA yang sudah ada tidak terbaca lagi
# setelah restart. Isi dengan string acak yang panjang dan JANGAN diubah setelah ada data asli.
SSO_DEMO_KEY=ganti-dengan-string-acak-yang-panjang-dan-rahasia

# Admin panel (/admin) — dipakai sekali saat data masih kosong untuk membuat akun admin pertama.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345
